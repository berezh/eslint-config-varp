{
  "name": "eslint-config-varp",
  "version": "2.12.0",
  "description": "ESLint, Prettier, Stylelint configs by Varp",
  "main": "index.js",
  "keywords": [
    "typescript",
    "eslint",
    "prettier",
    "config"
  ],
  "repository": "https://github.com/berezh/eslint-config-varp",
  "author": "Varp",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint:fix": "stylelint \"**/*.scss\" --fix",
    "v": "npm --no-git-tag-version version minor",
    "tsc": "tsc",
    "pm": "git add * && git commit -m\"update\" && git push origin master",
    "p": "npm run v && git add * && git commit -m\"v\" && git push origin master"
  },
  "dependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.1.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.25.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
